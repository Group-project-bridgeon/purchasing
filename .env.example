# Sanitized operator example. Application configuration is environment-only;
# the server never loads a local .env automatically. Do not commit real values.
# Host run: replace port with Platform's configured PostgreSQL host port.
# Container run: use host postgres and port 5432, never localhost:5433.
DATABASE_URL=postgres://purchasing_service@127.0.0.1:5432/purchasing_db?sslmode=disable
PGPASSWORD=REPLACE_WITH_SERVICE_DATABASE_PASSWORD
SERVER_PORT=8080
LISTEN_HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
# Public verification key ONLY; never provide Auth's private signing key.
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=erp-auth
JWT_AUDIENCE=erp-api
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT=5s
STARTUP_TIMEOUT=15s
READINESS_TIMEOUT=1s
SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_OPERATION_TIMEOUT=5s
# No production dispatcher exists; true is rejected, not log-acknowledged.
OUTBOX_PUBLISHER_ENABLED=false
